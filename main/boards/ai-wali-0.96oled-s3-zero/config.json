{
    "target": "esp32s3",
    "builds": [
        {
            "name": "ai-wali-0.96oled-s3-zero",
            "sdkconfig_append": [
                // 点击vscode的build按钮时，以下配置 不会 被识别！
                // 以下配置需要手动在 menuconfig 中设置，或者直接修改 sdkconfig 文件，才能生效！
                // 拷贝时不用带引号
                
                // 只有用 python scripts/release.py ai-wali-0.96oled-s3-zero 进行 release 构建时，以下配置才会被识别并生效！
                // 特别 Flash 大小配置
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE=\"8MB\"",
                // 特别分区表配置
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/8m.csv\"",
                "CONFIG_PARTITION_TABLE_FILENAME=\"partitions/v2/8m.csv\"",
                // 特别 PSRAM 配置
                "CONFIG_ESP32S3_DATA_CACHE_32KB=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_TYPE_AUTO=y",
                // AEC功能开关
                "CONFIG_USE_AUDIO_PROCESSOR=y",
                "CONFIG_USE_DEVICE_AEC=y"
            ]
        }
    ]
}